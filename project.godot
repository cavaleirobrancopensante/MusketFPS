; Engine configuration file.

config_version=5

[application]

config/name="MusketFPS"
config/version="1.67"
config/description="An officer with a musket and his company against lizardmen. 2D and 3D versions."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
Lang="*res://scripts/lang.gd"
RotateOverlay="*res://scripts/rotate_overlay.gd"
Company="*res://scripts/company.gd"
World="*res://scripts/world.gd"
Music="*res://scripts/music.gd"
Loading="*res://scripts/loading.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gui]

common/default_scroll_deadzone=18
